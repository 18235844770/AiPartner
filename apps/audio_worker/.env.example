HOST=127.0.0.1
PORT=8100
# stub | sensevoice | auto
ASR_BACKEND=stub
# stub | cosyvoice3 | auto
TTS_BACKEND=stub
ASR_MODEL_NAME=iic/SenseVoiceSmall
TTS_MODEL_NAME=Fun-CosyVoice3-0.5B-2512
# CosyVoice 官方仓库本地路径
