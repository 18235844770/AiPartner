APP_ENV=development
ACCOUNT_MODE=false
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DATABASE_URL=postgresql+asyncpg://companion:companion@127.0.0.1:5432/companion
REDIS_URL=redis://127.0.0.1:6379/0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=1
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B-Q
AUDIO_WORKER_URL=http://127.0.0.1:8100
AUDIO_WORKER_TIMEOUT_SECONDS=120
ASR_MODEL_NAME=FunAudioLLM/SenseVoiceSmall
# 只用于识别旧的本地合成缓存，不再加载对应权重。
TTS_MODEL_NAME=Fun-CosyVoice3-0.5B-2512
